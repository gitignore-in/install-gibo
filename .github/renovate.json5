{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>kitsuyui/renovate-config"
  ],
  // The gibo version in action.yml is intentionally not Renovate-managed.
  // Its checksum anchors must be updated in the same reviewed commit as the
  // version pin; a version-only Renovate PR would break or bypass the trust
  // anchor documented in README.md.
  "packageRules": [
    {
      "description": "Manage GitHub Actions workflow updates with Renovate.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
